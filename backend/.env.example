PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_ADDRESSES=0x1234567890123456789012345678901234567890,0x0987654321098765432109876543210987654321

# Blockchain
ORACLE_PRIVATE_KEY=your_oracle_private_key_here
RPC_URL=http://localhost:8545
CONTRACT_ADDRESS_TRENDFI=0x...
CONTRACT_ADDRESS_TRENDMARKET=0x...
CONTRACT_ADDRESS_TRENDORACLE=0x...
CONTRACT_ADDRESS_TRENDCONFIG=0x...

# Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000
